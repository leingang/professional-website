    TagBox[\(\[SkeletonIndicator]  SurfaceGraphics  \[SkeletonIndicator]\),
      False,
      Editable->False]], "Output"]
}, Open  ]],

Cell["Here's how we can compute the normal vector:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Cross[{1, 0, D[f, x]}, {0, 1, D[f, y]}]\)], "Input"],

Cell[BoxData[
    \({\(-2\)\ x, \(-\(y\/2\)\), 1}\)], "Output"]
}, Open  ]],

Cell["Here we can find the expression for the plane.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(tgt = \((f /. \ {x \[Rule] 1, 
              y \[Rule] 2})\)\  + \ \((D[f, x]\  /. \ {x \[Rule] 1, 
                y \[Rule] 2})\) \((x - 
              1)\)\  + \ \((D[f, y]\  /. \ {x \[Rule] 1, 
                y \[Rule] 2})\) \((y - 2)\)\)], "Input"],

Cell[BoxData[
    \(2\ \((\(-1\) + x)\) + y\)], "Output"]
}, Open  ]],

Cell["\<\
(In case you're wondering about the syntax for the /. operator, \
read the page linked to after this help message:)\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?ReplaceAll\)\)], "Input"],

Cell[BoxData[
    RowBox[{"\<\"expr /. rules applies a rule or list of rules in an attempt \
to transform each subpart of an expression expr.\"\>", " ", 
      ButtonBox[
        StyleBox["More\[Ellipsis]",
          "SR"],
        ButtonData:>"ReplaceAll",
        Active->True,
        ButtonStyle->"RefGuideLink"]}]], "Print",
  CellTags->"Info3350874792-2302356"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(planePlot = Plot3D[tgt, {x, \(-2\), 2}, {y, \(-2\), 2}]\)], "Input"],

