Cell[CellGroupData[{

Cell["Linear Approximation", "Section"],

Cell[TextData[{
  "The number of units of output per day at a factory is\n\n\t",
  Cell[BoxData[
      \(TraditionalForm\`P(x, y)\  = \ 
        150 \((\(1\/10\) x\^\(-2\) + \(9\/10\) \
y\^\(-2\))\)\^\(\(-1\)/2\)\)]],
  "\n\nwhere ",
  Cell[BoxData[
      \(TraditionalForm\`x\)]],
  " denotes capital investment (in units of $1000),and ",
  Cell[BoxData[
      \(TraditionalForm\`y\)]],
  " denotes the total number of hours (in units of 10) the work force is \
employed per day. Suppose that currently, capital investment is $50,000 an \
the total number of working hours per day is 500. Estimate the change in \
output if capital investment is increased by $5000 and the number of working \
hours is decreased by 10 per day."
}], "Text"],

Cell[BoxData[
    \(P = \ 
      150\ \((\(1\/10\) x\^\(-2\) + \ \(9\/10\) \
y\^\(-2\))\)\^\(\(-1\)/2\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(P\  /. {x \[Rule] 50, y \[Rule] 50}\)], "Input"],

Cell[BoxData[
    \(7500\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(D[P, x]\), "\[IndentingNewLine]", 
    \(% /. \ {x \[Rule] 50, y \[Rule] 50}\)}], "Input"],

Cell[BoxData[
    \(15\/\(x\^3\ \((1\/\(10\ x\^2\) + 9\/\(10\ y\^2\))\)\^\(3/2\)\)\)], \
"Output"],

Cell[BoxData[
    \(15\)], "Output"]
}, Open  ]],

Cell["\<\
The percent operator means \"output of the last evaluated \
statement.\"  If you're evaluating cells out of order, what % evaluates to \
can change.  Sometimes it's best to put both statements in the same cell so \
you always evaluate them in the same order.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?%\)\)], "Input"],

Cell[BoxData[
    RowBox[{"\<\"%n or Out[n] is a global object that is assigned to be the \
value produced on the nth output line. % gives the last result generated. %% \
gives the result before last. %% ... % (k times) gives the kth previous \
result.\"\>", " ", 
      ButtonBox[
        StyleBox["More\[Ellipsis]",
          "SR"],
        ButtonData:>"Out",
        Active->True,
        ButtonStyle->"RefGuideLink"]}]], "Print",
  CellTags->"Info3350874949-5438909"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(D[P, y]\), "\[IndentingNewLine]", 
    \(% /. \ {x \[Rule] 50, y \[Rule] 50}\)}], "Input"],

Cell[BoxData[
    \(135\/\(\((1\/\(10\ x\^2\) + 9\/\(10\ y\^2\))\)\^\(3/2\)\ y\^3\)\)], \
"Output"],

Cell[BoxData[
    \(135\)], "Output"]
}, Open  ]],

Cell["The linear approximation to the new production value is", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(7500\  + \ 15\ \((5)\)\  + \ 135 \((\(-1\))\)\)], "Input"],

Cell[BoxData[
    \(7440\)], "Output"]
}, Open  ]],

Cell["The actual new production value is", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(P /. {x \[Rule] 55, y \[Rule] 49}\)], "Input"],

Cell[BoxData[
    \(404250\ \@\(5\/14813\)\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(N[%, 10]\)], "Input"],

Cell[BoxData[
    \(7427.0016316829724484133`10. \)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(N[\(60 - 73\)\/73]\)], "Input"],

Cell[BoxData[
    \(\(-0.1780821917808219`\)\)], "Output"]
}, Open  ]],

Cell["So the error in estimation is about 17%.", "Text"]
}, Open  ]]
}, Open  ]]
},
