## -*- coding: utf-8 -*-
<%namespace name="helper" file="post_helper.tmpl"/>
<%namespace name="comments" file="comments_helper.tmpl"/>

<%def name="html_title()">
## title goes in hero now.
</%def>

<%def name="html_translations(post)">
    % if len(post.translated_to) > 1:
        <div class="metadata posttranslations translations">
            <h3 class="posttranslations-intro">${messages("Also available in:")}</h3>
            % for langname in sorted(translations):
                % if langname != lang and post.is_translation_available(langname):
                <p><a href="${post.permalink(langname)}" rel="alternate" hreflang="${langname}">${messages("LANGUAGE", langname)}</a></p>
                % endif
            % endfor
        </div>
    % endif
</%def>

<%def name="html_sourcelink()">
    % if show_sourcelink:
        <span class="sourceline"><a href="${post.source_link()}" id="sourcelink">${messages("Source")}</a></span>
    % endif
</%def>

<%def name="html_post_header()">
    <header>
        ${html_title()}
        <div class="metadata">
            <div class="post-date">
                <time class="published dt-published" datetime="${post.formatted_date('webiso')}" title="${post.formatted_date(date_format)|h}">${post.formatted_date(date_format)|h}</time>
                ## FIXME: everything within the span here gets styled "float: right".  Seems like bad CSS
                <span>
                    %if not post.meta('nocomments') and site_has_comments:
                        <!-- p class="commentline" -->
                        ${comments.comment_link(post.permalink(), post._base_path)}
                        <!--/p -->
                    %endif
                    % if post.meta('link'):
                        <!-- span class="linkline" -->
                        <a href="${post.meta('link')}">link</a>
                        <!-- /span -->
                    % endif
                    %if show_sourcelink:
                        <!-- span class="sourceline" -->
                        <a href="${post.source_link()}" id="sourcelink">${messages("Source")}</a>
                        <!-- /span -->
                    %endif
                </span>
            </div>
        </div>
        ${html_translations(post)}
    </header>
</%def>
