## -*- coding: utf-8 -*-
<%inherit file="list_post.tmpl"/>

<%block name="extra_head">
    ${parent.extra_head()}
    %if len(translations) > 1 and generate_rss:
        %for language in sorted(translations):
            <link rel="alternate" type="application/rss+xml" title="RSS for ${kind} ${tag|h} (${language})" href="${_link(kind + "_rss", tag, language)}">
        %endfor
    %elif generate_rss:
        <link rel="alternate" type="application/rss+xml" title="RSS for ${kind} ${tag|h}" href="${_link(kind + "_rss", tag)}">
    %endif
</%block>

<%block name="html_title">
    <h1>${title|h}</h1>
</%block>

<%block name="html_subtitle">
    %if description:
    <h2>${description}</h2>
    %endif
</%block>

<%block name="cover_image" filter="trim">
%if category and category in category_cover_images:
    ${category_cover_images[category]}
%elif tag in tag_cover_images:
    ${tag_cover_images[tag]}
%else:
    ${self.attr.cover_image_}
%endif
</%block>

<%block name="html_breadcrumb">
    <section id="breadcrumb">
        <div class="container">
            <div class="row">
                <div class="col-md-10 col-md-offset-1">
                    <ol class="breadcrumb">
                        <li><a href="${_link("root", None, lang)}">Home</a></li>
                        %if category:
                        <%!
                            from posixpath import dirname, basename
                            from string import capwords
                        %>
                        <%
                            catcopy = category
                            path = []
                            while (catcopy != ''):
                                name = basename(catcopy)
                                if not name.isupper():
                                    name = capwords(name)
                                path.append((_link('category',catcopy),name))
                                catcopy = dirname(catcopy)
                            path.reverse()
                        %>
                            %for link,name in path:
                                <li><a ${'class="active"' if loop.last() else ''}
                                       href="${"" if loop.last() else link}">${name}</a></li>
                            %endfor
                        %endif
                    </ol>
                </div>
            </div>
        </div>
    </section>
</%block>

<%block name="content">
<article class="tagpage">
    <header>
        %if subcategories:
        <h3>${messages('Subcategories:')}</h3>
        <ul>
            %for name, link in subcategories:
            <li><a href="${link}">${name|h}</a></li>
            %endfor
        </ul>
        %endif
    </header>
    %if posts:
        <ul class="postlist">
        % for post in posts:
            <li><time class="post-date" datetime="${post.formatted_date('webiso')}" title="${post.formatted_date(date_format)|h}">${post.formatted_date(date_format)|h}</time>
                <span> </span>
                <a href="${post.permalink()}" class="listtitle">${post.title()|h}</a>
            </li>
        % endfor
        </ul>
    %endif
    <div class="metadata text-center">
        <div class="custom_images">
            <ul class="social-links outline">
                %if len(translations) > 1 and generate_rss:
                    %for language in sorted(translations):
                        <li><a href="${_link(kind + "_rss", tag, language)}" hreflang="${language}" type="application/rss+xml">
                            <i class="fa fa-feed"></i>${messages('RSS feed', language)} (${language})</a>
                        </li>
                    %endfor
                %elif generate_rss:
                    <li><a href="${_link(kind + "_rss", tag)}" type="application/rss+xml"><i class="fa fa-feed"></i></a>
                %endif
                <li><a class="addthis_button_facebook"><i class="icon-facebook"></i></a></li>
                <li><a class="addthis_button_twitter"><i class="icon-twitter"></i></a></li>
                <li><a class="addthis_button_linkedin"><i class="fa fa-linkedin"></i></a></li>
                ## this one doesn't work, but "addthis_button_google_plusone" adds a plus count that I don't want
                <li><a class="addthis_button_google_plus"><i class="icon-googleplus"></i></a></li>
            </ul>
        </div>
    </div>
</article>
</%block>
