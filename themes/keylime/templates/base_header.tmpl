## -*- coding: utf-8 -*-
<%namespace name="base" file="base_helper.tmpl" import="*"/>

<%def name="html_header()">
    <header id="header">
        ${html_site_title()}
        ${html_translation_header()}
        ${html_navigation_links()}
        %if search_form:
            <div class="searchform" role="search">
                ${search_form}
            </div>
        %endif
    </header>
    ${template_hooks['page_header']()}
</%def>

<%def name="html_title()">
    <h1>${blog_title.upper() | h}</h1>
</%def>

## overload in descendents
<%def name="html_subtitle()">
    <h2>${blog_description|h}</h2>
</%def>


<%def name="html_menu()">
    <div id="menu" class="menu-right">
        <ul>
            <li>
                <form class="menu-search" action="https://www.google.com/search">
                    <div class="form-group header">
                        <i class="icon-search searchico"></i>
                        <input type="text" name="q" placeholder="Search">
                        <input type="hidden" name="sitesearch" value="${abs_link(_link("root", None, lang))}">
                        <a href="#" class="close-menu"><i class="icon-close"></i></a>
                    </div>
                </form>
            </li>
            <li><a href="${_link("root", None, lang)}"><i class="fa fa-home" aria-hidden="true"></i>Home</a></li>
            <li><a href="${_link('slug','about')}"><i class="icon-user"></i>About</a></li>
            <li class="submenu">
                <a href="#"><i class="icon-books"></i>Categories<b class="caret"></b></a>
                <ul class="submenu-list">
                    <%! from string import capwords %>
                    %for suburl, count, text in CATEGORY_MENU:
                        <% if not text.isupper():
                               text = capwords(text)
                        %>
                        % if rel_link(permalink, suburl) == "#":
                            <li class="active"><a href="${permalink}">${text}<span class="badge">${count}</span><span class="sr-only">${messages("(active)", lang)}</span></a>
                        %else:
                            <li><a href="${suburl}">${text}<span class="badge ${loop.cycle('golden','','red','blue')}">${count}</span></a>
                        %endif
                    %endfor
                </ul>
            </li>
            <!-- <li class="submenu submenu-open">
                <a href="#"><i class="icon-file"></i>Pages<b class="caret"></b></a>
                <ul class="submenu-list">
                    <li><a href="post-image.html">Post Image</a></li>
                    <li><a href="post-audio.html">Post Audio</a></li>
                    <li><a href="post-video.html">Post Video</a></li>
                    <li><a href="post-typography.html">Typography</a></li>
                    <li><a href="author.html">Author</a></li>
                    <li><a href="search.html">Search</a></li>
                    <li><a href="404.html">404 Error</a></li>
                </ul>
            </li> -->
            <li class="submenu">
                <a href="#"><i class="icon-calendar"></i>Archives <b class="caret"></b></a>
                <ul class="submenu-list">
                    <li><a href="archives.html">June<span>2014</span></a></li>
                    <li><a href="archives.html">May<span>2014</span></a></li>
                    <li><a href="archives.html">January<span>2014</span></a></li>
                    <li><a href="archives.html">October<span>2013</span></a></li>
                </ul>
            </li>
            <li><a href="${_link('slug','contact')}"><i class="icon-envelope"></i>Contact</a></li>
            <li><a href="/rss.xml"><i class="fa fa-rss"></i>Feed</a></li>
        </ul>
    </div>
</%def>

<%def name="html_main_nav()">
    <div id="main-nav" class="">
        <div class="container">
            <div class="nav-header">
                <a class="nav-brand" href="${_link("root", None, lang)}">${blog_title}</a>
                <a class="menu-link nav-icon" href="#"><i class="icon-menu2"></i></a>
            </div>
        </div>
    </div>
</%def>

<%def name="html_hero()">
    <section id="hero" class="light-typo">
        <div id="cover-image" class="image-bg animated fadeIn"></div>
        <div class="container welcome-content">
            <div class="middle-text">
                ${html_title()}
                ${html_subtitle()}
            </div>
        </div>
    </section>
</%def>

<%def name="html_title()">
    <h1>${blog_title.upper() | h}</h1>
</%def>

## overload in descendents
<%def name="html_subtitle()">
    <h2>${blog_description|h}</h2>
</%def>

<%def name="html_site_title()">
    <h1 id="brand"><a href="${abs_link(_link("root", None, lang))}" title="${blog_title|h}" rel="home">
    %if logo_url:
        <img src="${logo_url}" alt="${blog_title|h}" id="logo">
    %endif

    % if show_blog_title:
        <span id="blog-title">${blog_title|h}</span>
    % endif
    </a></h1>
</%def>

<%def name="html_navigation_links()">
    <nav id="menu">
    <ul>
    %for url, text in navigation_links[lang]:
        % if isinstance(url, tuple):
            <li> ${text}
            <ul>
            %for suburl, text in url:
                % if rel_link(permalink, suburl) == "#":
                    <li class="active"><a href="${permalink}">${text} <span class="sr-only">${messages("(active)", lang)}</span></a></li>
                %else:
                    <li><a href="${suburl}">${text}</a></li>
                %endif
            %endfor
            </ul>
        % else:
            % if rel_link(permalink, url) == "#":
                <li class="active"><a href="${permalink}">${text} <span class="sr-only">${messages("(active)", lang)}</span></a></li>
            %else:
                <li><a href="${url}">${text}</a></li>
            %endif
        % endif
    %endfor
    ${template_hooks['menu']()}
    ${template_hooks['menu_alt']()}
    </ul>
    </nav>
</%def>

<%def name="html_translation_header()">
    %if len(translations) > 1:
        <div id="toptranslations">
            <h2>${messages("Languages:")}</h2>
            ${base.html_translations()}
        </div>
    %endif
</%def>
