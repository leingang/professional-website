## -*- coding: utf-8 -*-
<%inherit file="index.tmpl"/>

<%block name="html_title">
    <h1>${title}</h1>
</%block>

<%block name="html_subtitle">
%if description:
    <h2>${description}</h2>
%endif
</%block>

<%block name="cover_image" filter="trim">
%if category and category in category_cover_images:
    ${category_cover_images[category]}
%elif tag in tag_cover_images:
    ${tag_cover_images[tag]}
%else:
    ${self.attr.cover_image_}
%endif
</%block>

<%block name="html_breadcrumb">
    <section id="breadcrumb">
        <div class="container">
            <div class="row">
                <div class="col-md-10 col-md-offset-1">
                    <ol class="breadcrumb">
                        <li><a href="${_link("root", None, lang)}">Home</a></li>
                        %if category:
                        <%!
                            from posixpath import dirname, basename
                            from string import capwords
                        %>
                        <%
                            catcopy = category
                            path = []
                            while (catcopy != ''):
                                name = category_title[basename(catcopy)]
                                path.append((_link('category',catcopy),name))
                                catcopy = dirname(catcopy)
                            path.reverse()
                        %>
                            %for link,name in path:
                                %if loop.last:
                                    <li class="active">${name}</li>
                                %else:
                                    <li><a href="${link}">${name}</a></li>
                                %endif
                            %endfor
                        %endif
                    </ol>
                </div>
            </div>
            <% visible_subcategories=[(name,link) for (name,link) in subcategories if not name in hidden_categories] %>
            %if visible_subcategories:
            <div class="row">
                <div class="col-md-10 col-md-offset-1">
                    <nav class="nav nav-inline breadcrumb">
                        Subcategories:
                        %for name,link in visible_subcategories:
                            <a class="nav-link" href="${link}">${category_title[name]}</a>${', ' if not loop.last else ''}
                        %endfor
                    </nav>
                </div>
            </div>
            %endif
        </div>
    </section>
</%block>

<%block name="content_header"></%block>

<%block name="extra_head">
    ${parent.extra_head()}
    %if len(translations) > 1 and generate_atom:
        %for language in sorted(translations):
            <link rel="alternate" type="application/atom+xml" title="Atom for the ${tag|h} section (${language})" href="${_link(kind + "_atom", tag, language)}">
        %endfor
    %elif generate_atom:
        <link rel="alternate" type="application/atom+xml" title="Atom for the ${tag|h} section" href="${_link("tag" + "_atom", tag)}">
    %endif
</%block>
