## -*- coding: utf-8 -*-
<%inherit file="index.tmpl"/>

<%block name="html_title">
    <h1>${title}</h1>
</%block>

<%block name="html_subtitle">
%if description:
    <h2>${description}</h2>
%endif
</%block>

<%block name="cover_image">
%if category and category in category_cover_images:
    ${category_cover_images[category]}
%elif tag in tag_cover_images:
    ${tag_cover_images[tag]}
%else:
    /assets/img/cover.jpg
%endif
</%block>

<%block name="content_header">
    %if subcategories:
    <h3>Subcategories</h3>
    <ul>
        %for name, link in subcategories:
        <li><a href="${link}">${name|h}</a></li>
        %endfor
    </ul>
    %endif
</%block>

<%block name="extra_head">
    ${parent.extra_head()}
    %if len(translations) > 1 and generate_atom:
        %for language in sorted(translations):
            <link rel="alternate" type="application/atom+xml" title="Atom for the ${tag|h} section (${language})" href="${_link(kind + "_atom", tag, language)}">
        %endfor
    %elif generate_atom:
        <link rel="alternate" type="application/atom+xml" title="Atom for the ${tag|h} section" href="${_link("tag" + "_atom", tag)}">
    %endif
</%block>
