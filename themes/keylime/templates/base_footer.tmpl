## -*- coding: utf-8 -*-
<%namespace name="base" file="base_helper.tmpl" import="*"/>

<%def name="html_footer(kw)">
    %if content_footer:
        <footer>
            <div class="footer">
                ## not sure where this should go.
                ${template_hooks['page_footer']()}
                <div class="container">
                    <div class="row">
                        <div class="col-sm-4 col-md-4 footer-widget">
                            <h3>Statistics</h3>
                            ${html_site_statistics()}
                        </div>
                        <div class="col-sm-4 col-md-4 footer-widget">
                            <h3>Recent posts</h3>
                            ${html_recent_posts()}
                        </div>
                        <div class="col-sm-4 col-md-4 footer-widget clearfix">
                            <h3>Tags</h3>
                            ${html_top_tags()}
                        </div>
                    </div>
                </div>
                <div class="copyright">
                    <div class="container">
                        <div class="pull-left">
                            <p>
                        %if 'cover_image_metadata' in kw and 'license' in kw['cover_image_metadata']:
                                ${html_image_citation(kw['cover_image_metadata'])}<br />
                        %endif
                                ${content_footer}
                            </p>
                        </div>
                        ${html_social_links()}
                    </div>
                </div>
            </div>
        </footer>
    %endif
</%def>

<%def name="html_recent_posts()" cached="True">
    <div class="post-recent-widget">
    	<div class="row">
    		<div class="col-sm-12">
                %for post in recent_posts:
                <%
                    cover_image = post.meta('coverimage')
                    if cover_image is not None:
                        try:
                            thumbnail_url=image_metadata[cover_image]['thumbnail_url']
                        except KeyError:
                            # probably a smarter way to do this but hey.
                            thumbnail_url="/assets/img/cover.jpg"
                %>
    			<div class="media">
    				<a class="pull-left" href="${_link('slug',post.meta('slug'))}"><img class="media-object" src="${thumbnail_url}" width="80" alt=""></a>
    				<div class="media-body">
    					<h4 class="media-heading"><a href="${_link('slug',post.meta('slug'))}">${post.meta('title')}</a></h4>
    					<p class="post-date">${post.formatted_date(date_format).lower()|h}</p>
    				</div>
    			</div>
                %endfor
    		</div>
    	</div>
    </div>
</%def>

<%def name="html_site_statistics()">
    <div class="stats">
        <div class="line">
            <span class="counter">${post_count}</span>
            <span class="caption">Posts</span>
        </div>
        <div class="line">
            <span class="counter">${category_count}</span>
            <span class="caption">Categories</span>
        </div>
        <div class="line">
            <span class="counter">${tag_count}</span>
            <span class="caption">Tags</span>
        </div>
    </div>
</%def>

<%def name="html_top_tags()">
    %if top_tags:
        <ul class="tags">
            %for tag in top_tags:
            <li><a href="${_link('tag',tag)}">${tag}</a></li>
            %endfor
        </ul>
    %endif
</%def>

<%def name="html_image_citation(kw)">
    %if 'web_page' in kw:
        <a href="${kw['web_page']}">Image</a>
    %else:
        Image
    %endif
    %if 'author_url' in kw:
        %if 'author_name' in kw:
            by <a href="${kw['author_url']}">${kw['author_name']}</a>
        %endif
    %else:
        %if 'author_name' in kw:
            by ${kw['author_name']}
        %endif
    %endif
    %if 'provider_url' in kw:
        %if 'provider_name' in kw:
            via <a href="${kw['provider_url']}">${kw['provider_name']}</a>
        %endif
    %else:
        %if 'provider_name' in kw:
            via ${kw['provider_name']}
        %endif
    %endif
    %if 'license_url' in kw:
        %if 'license' in kw:
            (<a href="${kw['license_url']}">${kw['license']}</a>)
        %endif
    %else:
        %if 'license' in kw:
            ${kw['license_name']}
        %endif
    %endif
</%def>

<%def name="html_social_links()">
    %if site_social_profiles:
    <ul class="social-links pull-right">
        %for site, url in site_social_profiles:
        <li><a href="${url}"><i class="${'icon-'+ site if site in ('twitter','facebook','googleplus') else 'fa fa-'+site}"></i></a></li>
        %endfor
    </ul>
    %endif
</%def>
